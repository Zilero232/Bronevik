{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["uv"],
  "ignoreDependencies": ["pino-pretty", "@prisma/client-runtime-utils", "stylelint-order", "lint-staged"],
  "ignoreUnresolved": ["^.$"],
  "rules": {
    "exports": "warn",
    "types": "warn"
  },
  "workspaces": {
    "apps/web/client": {
      "entry": [
        "shared/i18n/request/request.ts",
        "app/sw.ts",
        "config/panel-script/build-panel-script.ts",
        "views/twitch-panel/lib/panel-script/panel-entry.ts"
      ],
      "project": ["**/*.{ts,tsx,scss}"]
    },
    "apps/game/modpack": {
      "entry": ["ui-web/src/button/main.tsx", "ui-web/stylelint.config.mjs"],
      "project": ["ui-web/**/*.{ts,tsx,scss}"]
    },
    "apps/game/manager": {
      "project": ["web/**/*.{ts,tsx,scss}"]
    },
    "apps/web/server": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "prisma/**/*.prisma"]
    },
    "packages/design-tokens": {
      "entry": ["_index.scss"],
      "project": ["src/**/*.ts", "scss/**/*.{ts,scss}", "_index.scss"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
