# Three Marks — Caddy config for docker-compose.yml.
#
# The hosts come from the environment: SITE_DOMAIN for the site, API_DOMAIN for
# the API (the developer API /v1 included). With the defaults, localhost and
# api.localhost, Caddy issues itself a local certificate; with real domains it
# fetches one from Let's Encrypt over HTTP-01, so port 80 must stay reachable.
# HTTP/3 is on by default and needs 443/udp published (docker-compose.yml).

# `?` sets a header only when the upstream did not: the apps own their framing
# policy (overlays and the Telegram Mini App are frameable), Caddy only fills gaps.
(security_headers) {
	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Tokens ride some query strings (the Lesta ID callback's access_token, OAuth
# codes, tactic-board edit tokens): the access log drops them before writing.
# The Next server's internal API token (x-otmetki-internal-token) rides a header
# on every server-side API call and is dropped the same way.
(access_log) {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>X-Otmetki-Internal-Token delete
				request>uri query {
					delete access_token
					delete token
					delete code
					delete state
				}
			}
		}
	}
}

# Public downloads: the host folder DEPLOY_PATH/downloads, mounted read-only
# at /srv/downloads (docker-compose.yml) and filled by
# .github/workflows/release.yml. Without `browse` a folder answers 404, so
# nothing is listed. The content types are set here, before file_server,
# which only fills a missing one. Versioned folders (modpack/<version>/,
# manager/<version>/) never change under the same name; the stable names and
# the release index are revalidated on every request (ETag, Last-Modified).
(downloads) {
	root * /srv
	file_server

	@exe path *.exe
	header @exe {
		Content-Type application/vnd.microsoft.portable-executable
		Content-Disposition attachment
	}

	@mtmod path *.mtmod
	header @mtmod {
		Content-Type application/zip
		Content-Disposition attachment
	}

	@json path *.json
	header @json Content-Type "application/json; charset=utf-8"

	@sig path *.sig
	header @sig Content-Type "text/plain; charset=utf-8"

	@png path *.png
	header @png Content-Type image/png

	@webp path *.webp
	header @webp Content-Type image/webp

	@mp3 path *.mp3
	header @mp3 Content-Type audio/mpeg

	@mp4 path *.mp4
	header @mp4 Content-Type video/mp4

	@versioned path /downloads/modpack/* /downloads/manager/*
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@current path /downloads/releases.json /downloads/otmetki-manager-setup.exe /downloads/otmetki.mtmod
	header @current Cache-Control no-cache
}

{$API_DOMAIN} {
	# Overlay feeds are Server-Sent Events: compressing them would buffer the
	# stream, so they bypass the encoder. WebSockets (/tactics/ws) are never encoded.
	@compressible not path_regexp ^/overlays/[^/]+/stream$
	encode @compressible zstd gzip

	# bull-board (/admin/queues) stays off the public internet: reach it over
	# an ssh tunnel to the server container instead. The rest of /admin is the
	# role-guarded admin API and stays reachable.
	respond /admin/queues* 404

	reverse_proxy server:4000 {
		# A config reload keeps open WebSocket and SSE streams alive for a while
		# instead of cutting every tactic board and overlay at once.
		stream_close_delay 5m
	}

	import security_headers
	import access_log
}

{$SITE_DOMAIN} {
	encode zstd gzip

	handle /downloads/* {
		import downloads
	}

	handle {
		reverse_proxy client:3000
	}

	# Hashed assets never change under the same name.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	import security_headers
	import access_log
}
