# Keyless demo only (docker-compose.demo.yml mounts this into /etc/caddy/conf.d).
# Every player on a demo is generated: nothing on either host may be indexed,
# whatever the pages' own metadata says.

header >X-Robots-Tag "noindex, nofollow, noarchive"

@robots path /robots.txt
header @robots Content-Type "text/plain; charset=utf-8"
respond @robots <<TXT
	User-agent: *
	Disallow: /
	TXT 200
