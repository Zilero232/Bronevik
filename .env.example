# Copy to .env at the repo root. One file is shared by every app.
# Only secrets, addresses, ports and connection strings live here; tunables are
# code constants in apps/server/src/config/*.constants.ts.

NODE_ENV=development

# Optional pino overrides for every app. Level defaults to debug in dev, info in production;
# format defaults to pretty in dev, json in production (json | pretty).
# LOG_LEVEL=
# LOG_FORMAT=

# --- Client ---

# Baked into the bundle and visible to users. No secrets.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Server ---

PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Extra allowed origins, comma-separated. WEB_URL is always allowed.
CORS_ORIGINS=
# Proxies in front of the API (IPs or CIDR ranges, comma-separated) whose X-Forwarded-For entries are stripped
# to find the client IP for rate limits. Empty = one reverse proxy (Caddy) sending a single-entry X-Forwarded-For.
TRUSTED_PROXIES=

# --- Database ---

# TimescaleDB on Postgres 17 from docker-compose.dev.yml.
# 5434, not 5432: a native Postgres holds 5432 and GnomeVPN holds 5433.
DATABASE_URL=postgresql://otmetki:otmetki@localhost:5434/otmetki
DIRECT_URL=postgresql://otmetki:otmetki@localhost:5434/otmetki

# Connections per process. Unset: the API keeps 10, the worker sizes its pool to its queue concurrency (WORKER_DATABASE).
# DATABASE_POOL_MAX=

# --- Redis ---

# BullMQ queues, the shared Lesta rate-limit bucket, the hot cache.
REDIS_URL=redis://localhost:6380

# --- Auth ---

# 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-000

# --- Lesta API ---

# Server application id from https://developers.lesta.ru. Empty in development serves the
# in-process Lesta mock (see LESTA_MOCK); empty in production runs the worker degraded (no Lesta jobs).
LESTA_APPLICATION_ID=
# Requests per second for all processes together: 20 per registered IP, up to 5 IPs.
LESTA_RPS=20
# In-process fake Lesta API with seeded players, used only while LESTA_APPLICATION_ID is empty
# and never in production. auto = on in development, off in test; on = also in test; off = never.
LESTA_MOCK=auto

# --- Worker ---

# bull-board on the server at /admin/queues (user `admin`). Empty disables it.
BULL_BOARD_PASSWORD=

# --- Game data ---

# Optional. Raises the GitHub API limit for `bun run gamedata:import`.
GITHUB_TOKEN=

# --- Mod ---

# Root secret: per-device HMAC keys are derived from it. Rotating it unbinds every device.
MOD_INGEST_SECRET=dev-mod-secret-change-me

# --- Replay storage ---

# local keeps uploaded replays on disk (dev); s3 uses any S3-compatible bucket (prod).
REPLAY_STORAGE=local
# Directory for REPLAY_STORAGE=local, relative to the working directory.
REPLAY_STORAGE_DIR=.data/replays
# S3-compatible endpoint (empty = AWS). Needed only for REPLAY_STORAGE=s3.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Telegram bot ---

# An empty token switches the bot and the Telegram login off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Production receives updates at <TELEGRAM_WEBHOOK_URL>/telegram/webhook; both empty = long polling (dev).
TELEGRAM_WEBHOOK_URL=
# Random string Telegram echoes in x-telegram-bot-api-secret-token.
TELEGRAM_WEBHOOK_SECRET=

# --- Discord bot ---

# Empty token = no Discord bot. Application id doubles as the OAuth client id for "Connect Discord" in /me.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# OAuth2 client secret of the same application; empty hides "Connect Discord".
DISCORD_CLIENT_SECRET=

# --- VK bot and VK Mini App ---

# Community token with messages access. Empty token = no VK bot.
VK_BOT_TOKEN=
VK_GROUP_ID=
# Callback API: set both to receive updates at <API_URL>/vk/callback; empty = Bots Long Poll (dev).
VK_CALLBACK_CONFIRMATION=
VK_CALLBACK_SECRET=
# Mini App id and its protected key (signs the launch params). Empty disables the /vk mini app sign-in.
VK_MINI_APP_ID=
VK_MINI_APP_SECRET=
# VK ID app for "Connect VK" in /me. Optional.
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=

# --- Notifications ---

# Web Push VAPID keys: bunx web-push generate-vapid-keys. Empty disables web push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact sent to push services.
VAPID_SUBJECT=mailto:admin@triotmetki.ru

# SMTP for the weekly email digest. Empty SMTP_HOST disables email.
# Dev: Mailpit from docker-compose.dev.yml catches every mail (inbox http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASSWORD=dev
EMAIL_FROM="Три отметки <noreply@otmetki.local>"

# --- Payments ---

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true saves the card and charges renewals automatically (needs recurring enabled for the shop).
YOOKASSA_RECURRING=false

# --- Streamers ---

DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
# Twitch app for chat commands (!stat, !session, !marks), challenge announcements and auto-predictions.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# VK Видео Live DevAPI app (streamer live status). Optional: without it VK channels are never live.
VK_LIVE_CLIENT_ID=
VK_LIVE_CLIENT_SECRET=
# YouTube Data API key (live status of claimed channels). Optional: without it only the uploads RSS is read.
YOUTUBE_API_KEY=

# --- Production compose only (docker-compose.yml) ---

# Hosts Caddy serves and fetches certificates for.
# SITE_DOMAIN=triotmetki.ru
# API_DOMAIN=api.triotmetki.ru
# Postgres credentials; compose builds DATABASE_URL / DIRECT_URL / REDIS_URL for the containers itself.
# POSTGRES_USER=otmetki
# POSTGRES_PASSWORD=
# POSTGRES_DB=otmetki
