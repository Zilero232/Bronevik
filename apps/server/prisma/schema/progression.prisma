enum ShellReason {
  challenge
  level
  season
  purchase

  @@map("shell_reason")
}

enum CosmeticGrant {
  purchase
  season

  @@map("cosmetic_grant")
}

model TankChallengeProgress {
  accountId BigInt   @map("account_id")
  tankId    Int      @map("tank_id")
  weekStart DateTime @map("week_start") @db.Date
  code      String

  metric      String
  threshold   Float?
  progress    Float
  target      Float
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  player Player @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@id([accountId, tankId, weekStart, code])
  @@index([accountId, weekStart])
  @@map("tank_challenge_progress")
}

model ShellLedgerEntry {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId  String      @map("user_id")
  amount  Int
  reason  ShellReason
  key     String      @unique
  context Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("shell_ledger_entry")
}

model SeasonProgress {
  userId String @map("user_id")
  season String

  points Int @default(0)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, season])
  @@index([season, points(sort: Desc)])
  @@map("season_progress")
}

model CosmeticOwnership {
  userId String @map("user_id")
  code   String

  grant      CosmeticGrant
  acquiredAt DateTime      @default(now()) @map("acquired_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
  @@map("cosmetic_ownership")
}
