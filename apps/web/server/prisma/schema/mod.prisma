model ModDevice {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId     String  @map("user_id")
  accountId  BigInt? @map("account_id")
  name       String?
  secretHash String  @map("secret_hash")

  modVersion  String? @map("mod_version")
  gameVersion String? @map("game_version")

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  battles Battle[]
  replays Replay[]

  @@index([userId])
  @@index([accountId])
  @@map("mod_device")
}

enum ShareChannel {
  telegram
  discord

  @@map("share_channel")
}

model SessionSharePreference {
  userId String @id @map("user_id")

  enabled  Boolean        @default(false)
  channels ShareChannel[]

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_share_preference")
}
