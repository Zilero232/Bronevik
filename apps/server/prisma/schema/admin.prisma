enum ReportStatus {
  open
  resolved
  dismissed

  @@map("report_status")
}

enum DeletionSource {
  user
  lesta
  retention

  @@map("deletion_source")
}

enum DeletionStatus {
  pending
  processing
  completed
  failed

  @@map("deletion_status")
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved

  @@map("incident_status")
}

model FeatureFlag {
  key String @id

  description     String?
  enabled         Boolean @default(false)
  rolloutPercent  Int     @default(0) @map("rollout_percent") @db.SmallInt
  variants        Json?
  rules           Json?
  updatedByUserId String? @map("updated_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  actorUserId String? @map("actor_user_id")
  action      String
  entityType  String  @map("entity_type")
  entityId    String? @map("entity_id")
  metadata    Json?
  ip          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

model ContentReport {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  reporterUserId String?      @map("reporter_user_id")
  targetType     String       @map("target_type")
  targetId       String       @map("target_id")
  reason         String
  details        String?
  status         ReportStatus @default(open)
  resolvedBy     String?      @map("resolved_by")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  reporter User? @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_report")
}

model DataDeletionRequest {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  accountId         BigInt         @map("account_id")
  requestedByUserId String?        @map("requested_by_user_id")
  source            DeletionSource
  status            DeletionStatus @default(pending)
  reason            String?
  error             String?

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  requestedBy User? @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([accountId])
  @@map("data_deletion_request")
}

model CollectorJobMetric {
  queue       String
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(3)

  processed       Int    @default(0)
  failed          Int    @default(0)
  retried         Int    @default(0)
  durationMsTotal BigInt @default(0) @map("duration_ms_total")
  lestaRequests   Int    @default(0) @map("lesta_requests")
  lestaErrors     Int    @default(0) @map("lesta_errors")
  lagSeconds      Int?   @map("lag_seconds")
  queueDepth      Int?   @map("queue_depth")

  @@id([queue, bucketStart])
  @@index([bucketStart(sort: Desc)])
  @@map("collector_job_metric")
}

model CollectorState {
  key String @id

  value Json

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("collector_state")
}

model ServiceIncident {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  title     String
  body      String?
  component String
  status    IncidentStatus @default(investigating)

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@index([startedAt(sort: Desc)])
  @@map("service_incident")
}
